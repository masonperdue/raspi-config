[Unit]
Description=Immich Web and Application Server
After=immich-db.service immich-redis.service immich-ml.service
Requires=immich-db.service immich-redis.service immich-ml.service

[Container]
ContainerName=immich
Image=ghcr.io/immich-app/immich-server:release
Network=host
Environment=DB_HOSTNAME=immich-db
Environment=DB_USERNAME=immich
Environment=DB_PASSWORD=
Environment=DB_DATABASE_NAME=immich
Environment=REDIS_HOSTNAME=immich-redis
Environment=IMMICH_MACHINE_LEARNING_URL=http://immich-ml:3003
Volume=/etc/immich/photos:/data:Z
Volume=/etc/localtime:/etc/localtime:ro
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
